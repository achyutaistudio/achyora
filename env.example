# ACHYORA environment contract — names only, never real values.
#
# Copy to .env for local development; set the SAME names in Cloudflare
# (Workers & Pages -> Settings -> Variables and Secrets).
# VITE_* values must exist at BUILD time; everything else is a runtime secret.
# Nothing in this file requires editing application source code.

# ================================================================== CLIENT
# Public values, inlined into the browser bundle at build time.
# Required for the app to talk to Supabase from the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: reference only, not read by application code.
VITE_SUPABASE_PROJECT_ID=

# Optional. Public canonical origin, e.g. https://achyora.com
# Used only for <link rel="canonical"> / og:url. Auth redirects always use the
# real request origin, so this is never required for sign-in to work.
VITE_SITE_URL=

# Optional product analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ================================================================== SUPABASE (server)
# Server-only. NEVER prefix these with VITE_.
#
# Name aliasing: SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY are optional when the
# public VITE_SUPABASE_URL + VITE_SUPABASE_PUBLISHABLE_KEY (or
# VITE_SUPABASE_ANON_KEY) values above are set — server code resolves those
# public aliases automatically on every host. Set the explicit server names when
# the server must talk to a different project than the browser.
#
# SUPABASE_SERVICE_ROLE_KEY has NO alias: it is a real secret and must be
# supplied as a runtime secret (local .env.local / .dev.vars, Cloudflare secret,
# Vercel environment variable). Features that need admin access fail with a
# clear configuration error until it is set.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: reference only, not read by application code.
SUPABASE_PROJECT_ID=

# ================================================================== AI
# Which provider serves AI requests: gemini | openai | anthropic | gateway
# When set, it is authoritative: if that provider is not configured the request
# fails with a clear configuration error instead of silently using another one.
# When unset, the first provider with a key is used.
AI_PROVIDER=

# Optional model overrides (provider-specific ids).
AI_CHAT_MODEL=
AI_IMAGE_MODEL=
AI_VIDEO_MODEL=
AI_TRANSCRIBE_MODEL=

# Direct vendor keys — set the one(s) matching AI_PROVIDER.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: self-hosted / proxied OpenAI endpoint for AI_PROVIDER=openai
OPENAI_BASE_URL=

# ================================================================== AI GATEWAY
# Any OpenAI-compatible host (OpenRouter, Together, LiteLLM, vLLM, ...).
# BOTH are required for AI_PROVIDER=gateway. There is no built-in fallback host:
# if either is missing, the app returns "AI gateway is not configured."
AI_GATEWAY_BASE_URL=
# AI_GATEWAY_API_KEY also accepts the managed LOVABLE_API_KEY as an alias, so on
# Lovable Cloud only AI_PROVIDER=gateway + AI_GATEWAY_BASE_URL need to be set.
AI_GATEWAY_API_KEY=
# Optional model ids for the gateway (defaults to gpt-4o-mini for chat).
# On the Lovable AI gateway use e.g. google/gemini-2.5-flash and
# google/gemini-2.5-flash-image.
AI_GATEWAY_CHAT_MODEL=
AI_GATEWAY_IMAGE_MODEL=

# ================================================================== PAYMENTS
# Razorpay. The webhook secret must match the one configured in the Razorpay
# dashboard for the /api/public/razorpay-webhook endpoint.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ================================================================== LIMITS
# Optional. Salt for hashing guest/visitor identifiers (raw IPs are never stored).
# Set a long random value in production.
GUEST_HASH_SALT=

# Optional. Library upload ceiling in bytes (default 20971520 = 20 MB).
LIBRARY_MAX_UPLOAD_BYTES=
# Optional. Extra comma-separated MIME types to allow in the Library.
LIBRARY_EXTRA_MIME_TYPES=

# Optional. Maximum seconds a video job may be polled before it is cancelled
# and credits are refunded (default 600).
VIDEO_MAX_POLL_SECONDS=

# Optional per-endpoint rate limits, format "<requests>/<seconds>".
# Defaults shown. These are abuse protection, separate from credits/quota.
RATE_LIMIT_GUEST_CHAT=10/3600
RATE_LIMIT_CHAT=60/3600
RATE_LIMIT_COMPARE=20/3600
RATE_LIMIT_RESEARCH=30/3600
RATE_LIMIT_IMAGE=30/3600
RATE_LIMIT_VIDEO=10/3600
RATE_LIMIT_VOICE=40/3600
RATE_LIMIT_CHECKOUT=10/3600
RATE_LIMIT_LIBRARY_WRITE=60/3600

# ================================================================== DEPLOYMENT
# Optional. Overrides the server build target. The build always uses the nitro
# "cloudflare-module" preset unless this is set. Leave empty for Cloudflare.
NITRO_PRESET=
